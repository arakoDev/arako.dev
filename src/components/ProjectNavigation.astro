---
interface NavigationTarget {
	href: string;
	title: string;
}

interface Props {
	nextProject?: NavigationTarget;
	class?: string;
}

const { nextProject, class: className } = Astro.props;
const links = [
	{ eyebrow: 'Work archive', title: 'Browse all projects', href: '/work' },
	...(nextProject
		? [{ eyebrow: 'Next project', title: nextProject.title, href: nextProject.href }]
		: []),
];
---

<nav class:list={['border-t border-border-subtle pt-10', className]} aria-label="More project pages" data-reveal="scale">
	<ul
		class:list={[
			'grid gap-px overflow-hidden rounded-md border border-border-subtle bg-border-subtle',
			links.length > 1 && 'sm:grid-cols-2',
		]}
	>
		{
			links.map((link) => (
				<li class="bg-surface">
					<a
						class="motion-row group flex min-h-32 flex-col justify-between p-5 text-text-primary no-underline hover:bg-surface-raised"
						href={link.href}
					>
						<span class="text-label font-semibold uppercase tracking-label text-text-muted">
							{link.eyebrow}
						</span>
						<span class="mt-5 flex items-end justify-between gap-4 font-semibold">
							{link.title}
							<span class="motion-arrow text-accent" aria-hidden="true">
								→
							</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>
