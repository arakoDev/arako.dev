---
import { formatUploadDate } from '../utils/date';

interface Props {
	date: string;
	class?: string;
}

const { date, class: className } = Astro.props;
const formattedDate = formatUploadDate(date);
---

<time
	class:list={[
		'inline-flex items-center gap-2 rounded-full border border-border-subtle bg-background/90 px-3 py-1.5 text-xs font-semibold text-text-muted shadow-sm backdrop-blur-sm',
		className,
	]}
	datetime={date}
	aria-label={`Video uploaded ${formattedDate}`}
	title="YouTube upload date"
>
	<svg
		class="h-3.5 w-3.5 shrink-0 text-accent"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="9"></circle>
		<path d="M12 7v5l3 2"></path>
	</svg>
	{formattedDate}
</time>
