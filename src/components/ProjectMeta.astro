---
interface Props {
	year: number;
	role: string;
	duration: string;
	status: string;
	team: string;
	client?: string;
	services: string[];
	tags: string[];
	class?: string;
}

const {
	year,
	role,
	duration,
	status,
	team,
	client,
	services,
	tags,
	class: className,
} = Astro.props;
const details = [
	{ label: 'Year', value: year },
	{ label: 'Role', value: role },
	{ label: 'Duration', value: duration },
	{ label: 'Status', value: status },
	{ label: 'Team', value: team },
	...(client ? [{ label: 'Client / project', value: client }] : []),
];
---

<section class:list={['border-y border-border-subtle', className]} aria-labelledby="project-details-title">
	<h2 id="project-details-title" class="sr-only">Project details</h2>
	<dl class="grid gap-x-8 gap-y-6 py-5 sm:grid-cols-2 lg:grid-cols-3">
		{
			details.map(({ label, value }) => (
				<div>
					<dt class="text-label font-semibold uppercase tracking-label text-text-muted">{label}</dt>
					<dd class="mt-2 text-sm leading-6 text-text-primary">{value}</dd>
				</div>
			))
		}
	</dl>

	<div class="grid gap-6 border-t border-border-subtle py-5 sm:grid-cols-2">
		<div>
			<h3 class="text-label font-semibold uppercase tracking-label text-text-muted">Services</h3>
			<ul class="mt-3 flex flex-wrap gap-2" aria-label="Services provided">
				{
					services.map((service) => (
						<li class="rounded-sm border border-border-subtle bg-surface px-2.5 py-1 text-sm text-text-primary">
							{service}
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<h3 class="text-label font-semibold uppercase tracking-label text-text-muted">Technical focus</h3>
			<ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2" aria-label="Technical tags">
				{
					tags.map((tag) => (
						<li class="font-mono text-sm text-text-muted">{tag}</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
