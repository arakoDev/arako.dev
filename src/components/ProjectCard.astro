---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { description, slug, thumbnail, title, year } = project.data;
---

<article>
	<a
		class="group block overflow-hidden rounded-md border border-border bg-surface no-underline hover:border-accent/40"
		href={`/work/${slug}`}
		aria-label={`View ${title}`}
	>
		<div class="aspect-video overflow-hidden border-b border-border bg-background">
			<img
				class="h-full w-full object-cover group-hover:opacity-90"
				src={thumbnail}
				alt={`${title} thumbnail`}
				loading="lazy"
			/>
		</div>

		<div class="p-5 sm:p-6">
			<p class="m-0 text-xs font-semibold uppercase tracking-[0.14em] text-accent">{year}</p>
			<h2
				class="mt-3 text-xl font-semibold tracking-tight text-text-primary group-hover:text-accent sm:text-2xl"
			>
				{title}
			</h2>
			<p class="mt-3 line-clamp-3 text-sm leading-6 text-text-muted sm:text-base">
				{description}
			</p>

			<p class="mt-5 text-sm font-medium text-text-primary group-hover:text-accent" aria-hidden="true">
				View project &rarr;
			</p>
		</div>
	</a>
</article>
