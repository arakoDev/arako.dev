---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { heroAlt, heroImage, summary, title, year } = project.data;
---

<article>
	<a
		class="group block overflow-hidden rounded-md border border-border bg-surface no-underline transition-colors hover:border-accent"
		href={`/work/${project.id}`}
		aria-label={`View ${title}`}
	>
		<div class="aspect-video overflow-hidden border-b border-border bg-background">
			<Image
				class="h-full w-full object-cover transition-opacity group-hover:opacity-90"
				src={heroImage}
				alt={heroAlt}
				loading="lazy"
			/>
		</div>

		<div class="p-5 sm:p-6">
			<p class="m-0 text-xs font-semibold uppercase tracking-[0.14em] text-accent">{year}</p>
			<h2
				class="mt-3 text-xl font-semibold tracking-tight text-text-primary transition-colors group-hover:text-accent sm:text-2xl"
			>
				{title}
			</h2>
			<p class="mt-3 line-clamp-3 text-sm leading-6 text-text-muted sm:text-base">
				{summary}
			</p>

			<p
				class="mt-5 text-sm font-medium text-text-primary transition-colors group-hover:text-accent"
				aria-hidden="true"
			>
				View project &rarr;
			</p>
		</div>
	</a>
</article>
