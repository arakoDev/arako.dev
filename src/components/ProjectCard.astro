---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

import { projectCategoryLabels, projectStatusLabels } from '../config/projects';

interface Props {
	project: CollectionEntry<'projects'>;
	headingLevel?: 2 | 3;
	priority?: boolean;
}

const { project, headingLevel = 2, priority = false } = Astro.props;
const { category, heroAlt, heroImage, role, status, summary, title, year } = project.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const responsiveWidths = [
	...new Set([480, 768, heroImage.width].filter((width) => width <= heroImage.width)),
];
---

<article class="h-full">
	<a
		class="group flex h-full flex-col overflow-hidden rounded-md border border-border bg-surface no-underline transition-colors hover:border-accent"
		href={`/work/${project.id}`}
		aria-label={`View case study: ${title}`}
	>
		<div class="aspect-video overflow-hidden border-b border-border bg-background">
			<Image
				class="h-full w-full object-cover transition-opacity group-hover:opacity-90"
				src={heroImage}
				alt={heroAlt}
				widths={responsiveWidths}
				sizes="(max-width: 47.99rem) calc(100vw - 2rem), (max-width: 72rem) calc(50vw - 2.5rem), 34rem"
				loading={priority ? 'eager' : 'lazy'}
				decoding="async"
			/>
		</div>

		<div class="flex flex-1 flex-col p-5 sm:p-6">
			<div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-label font-semibold uppercase tracking-label">
				<p class="text-accent">{projectCategoryLabels[category]}</p>
				<p class="text-text-muted">{projectStatusLabels[status]} · {year}</p>
			</div>

			<Heading
				class="mt-3 text-xl font-semibold tracking-tight text-text-primary transition-colors group-hover:text-accent sm:text-2xl"
			>
				{title}
			</Heading>
			<p class="mt-2 text-sm font-medium text-text-primary">{role}</p>
			<p class="mt-3 text-sm leading-6 text-text-muted sm:text-base">
				{summary}
			</p>

			<p
				class="mt-auto pt-5 text-sm font-medium text-text-primary transition-colors group-hover:text-accent"
				aria-hidden="true"
			>
				Read case study &rarr;
			</p>
		</div>
	</a>
</article>
