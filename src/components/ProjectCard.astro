---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

import { projectCategoryLabels } from '../config/projects';
import UploadDate from './UploadDate.astro';

interface Props {
	project: CollectionEntry<'projects'>;
	headingLevel?: 2 | 3;
	priority?: boolean;
	revealDelay?: number;
}

const { project, headingLevel = 2, priority = false, revealDelay } = Astro.props;
const { categories, heroAlt, heroImage, summary, title, videoUploadDate } = project.data;
const categoryLabel = categories.map((category) => projectCategoryLabels[category]).join(' · ');
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const responsiveWidths = [
	...new Set([480, 768, heroImage.width].filter((width) => width <= heroImage.width)),
];
---

<article class="h-full" data-reveal="scale" data-reveal-delay={revealDelay}>
	<a
		class="motion-card group flex h-full flex-col overflow-hidden rounded-md border border-border bg-surface no-underline hover:border-accent"
		href={`/work/${project.id}`}
		aria-label={`View project: ${title}`}
	>
		<div class="relative aspect-video overflow-hidden border-b border-border bg-background">
			<Image
				class="motion-card-media h-full w-full object-cover group-hover:opacity-90"
				src={heroImage}
				alt={heroAlt}
				widths={responsiveWidths}
				sizes="(max-width: 47.99rem) calc(100vw - 2rem), (max-width: 72rem) calc(50vw - 2.5rem), 34rem"
				loading={priority ? 'eager' : 'lazy'}
				decoding="async"
			/>
			{videoUploadDate && <UploadDate class="absolute right-3 top-3" date={videoUploadDate} />}
		</div>

		<div class="flex flex-1 flex-col p-5 sm:p-6">
			<p class="text-label font-semibold uppercase tracking-label text-accent">
				{categoryLabel}
			</p>

			<Heading
				class="mt-3 text-xl font-semibold tracking-tight text-text-primary transition-colors group-hover:text-accent sm:text-2xl"
			>
				{title}
			</Heading>
			<p class="mt-3 text-sm leading-6 text-text-muted sm:text-base">
				{summary}
			</p>

			<p
				class="mt-auto pt-5 text-sm font-medium text-text-primary transition-colors group-hover:text-accent"
				aria-hidden="true"
			>
				View project <span class="motion-arrow">&rarr;</span>
			</p>
		</div>
	</a>
</article>
