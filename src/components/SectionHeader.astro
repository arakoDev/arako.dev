---
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	titleId?: string;
	headingLevel?: 2 | 3;
	class?: string;
}

const {
	eyebrow,
	title,
	description,
	titleId,
	headingLevel = 2,
	class: className,
} = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<header class:list={['max-w-reading', className]}>
	{eyebrow && <p class="m-0 text-label font-semibold uppercase tracking-label text-accent">{eyebrow}</p>}
	<Heading
		id={titleId}
		class:list={[
			'text-section-title font-semibold text-text-primary',
			eyebrow ? 'mt-2' : 'm-0',
		]}
	>
		{title}
	</Heading>
	{description && <p class="mt-4 text-base leading-7 text-text-muted">{description}</p>}
</header>
