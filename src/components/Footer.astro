---
import SocialLinks from './SocialLinks.astro';
import { site } from '../config/site';

const currentYear = new Date().getFullYear();
const footerNavigation = site.navigation;
---

<footer class="border-t border-border-subtle" data-reveal="footer">
	<div class="mx-auto max-w-content px-page py-8">
		<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-[1.5fr_0.75fr_0.75fr]">
			<div>
				<p class="m-0 font-semibold text-text-primary">{site.name}</p>
				<div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
					<span class="text-text-muted">Discord: {site.contact.discord}</span>
					<a class="motion-text-link text-text-muted hover:text-accent" href={`mailto:${site.contact.email}`}>
						{site.contact.email}
					</a>
				</div>
			</div>

			<nav aria-label="Primary footer navigation">
				<p class="text-xs font-semibold uppercase tracking-label text-text-primary">Explore</p>
				<ul class="mt-3 grid list-none gap-2 p-0 text-sm">
					{
						footerNavigation.map((item) => (
							<li>
								<a class="motion-text-link text-text-muted no-underline hover:text-accent" href={item.href}>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav aria-label="Commission pages">
				<p class="text-xs font-semibold uppercase tracking-label text-text-primary">Commission Info</p>
				<ul class="mt-3 grid list-none gap-2 p-0 text-sm">
					{
						site.secondaryNavigation.map((item) => (
							<li>
								<a class="motion-text-link text-text-muted no-underline hover:text-accent" href={item.href}>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		<div class="mt-8 flex flex-col gap-4 border-t border-border-subtle pt-5 sm:flex-row sm:items-center sm:justify-between">
			<p class="m-0 text-sm text-text-muted">&copy; {currentYear} {site.name}</p>
			<SocialLinks />
		</div>
	</div>
</footer>
