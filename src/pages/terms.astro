---
import CommissionNavigation from '../components/CommissionNavigation.astro';
import PageHeader from '../components/PageHeader.astro';
import { commissionTermGroups } from '../config/commissions';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Commission Terms"
	description="Scope, cancellation, delivery, support, ownership, and portfolio terms for commissions."
	mainClass="mx-auto w-full max-w-content px-page py-section"
>
	<PageHeader
		title="Commission terms"
		description="The final price, scope, and estimated deadline are agreed before work begins."
	/>

	<div class="mt-10">
		<CommissionNavigation />
	</div>

	<div class="mt-section-tight grid gap-12 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-16">
		<aside aria-label="On this page" data-reveal="left">
			<div class="lg:sticky lg:top-8">
				<p class="text-label font-semibold uppercase tracking-label text-text-primary">On this page</p>
				<nav class="mt-4">
					<ul class="grid list-none gap-3 p-0 text-sm">
						{commissionTermGroups.map((group) => (
							<li><a class="motion-text-link text-text-muted no-underline hover:text-accent" href={`#${group.id}`}>{group.title}</a></li>
						))}
					</ul>
				</nav>
			</div>
		</aside>

		<article class="max-w-reading">
			{
				commissionTermGroups.map((group) => (
					<section id={group.id} class="scroll-mt-8 border-t border-border-subtle py-10 first:pt-0 first:border-t-0" aria-labelledby={`${group.id}-heading`} data-reveal>
						<p class="font-mono text-sm text-accent">{group.number}</p>
						<h2 id={`${group.id}-heading`} class="mt-3 text-section-title font-semibold text-text-primary">{group.title}</h2>
						<ul class="mt-6 grid gap-5">
							{group.items.map((item) => (
								<li class="flex gap-4 text-base leading-7 text-text-muted">
									<span class="mt-[0.7rem] h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
									<span>{item}</span>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</article>
	</div>

	<nav class="mt-section-tight flex flex-wrap gap-x-6 gap-y-3 border-t border-border-subtle pt-6 text-sm" aria-label="Related commission information" data-reveal="left">
		<a class="motion-text-link font-semibold" href="/payments">← Payments</a>
		<a class="motion-text-link font-semibold" href="/commissions">Commission Info →</a>
	</nav>
</BaseLayout>
