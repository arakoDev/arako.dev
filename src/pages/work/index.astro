---
import { getCollection } from 'astro:content';

import Header from '../../components/Header.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { workTabs } from '../../config/workTabs';
import '../../styles/global.css';

const projects = (await getCollection('projects')).sort(
	(a, b) =>
		Number(b.data.featured) - Number(a.data.featured) ||
		b.data.year - a.data.year ||
		a.data.title.localeCompare(b.data.title),
);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Explore Arako's Roblox development projects, including combat systems, skills, open-source work, and prototypes."
		/>
		<title>Work | Arako</title>
	</head>
	<body class="flex min-h-screen flex-col">
		<Header />

		<main class="mx-auto w-full max-w-content flex-1 px-page py-section">
			<header class="max-w-2xl">
				<p class="m-0 text-sm font-semibold uppercase tracking-[0.14em] text-accent">Portfolio</p>
				<h1 class="mt-3 text-4xl font-semibold tracking-[-0.03em] text-text-primary sm:text-6xl">
					Work
				</h1>
				<p class="mt-5 text-base leading-7 text-text-muted sm:text-lg sm:leading-8">
					A selection of Roblox systems, gameplay features, open-source work, and experiments.
				</p>
			</header>

			<div class="mt-10 flex flex-wrap gap-2" aria-label="Filter projects by category">
				{
					workTabs.map((tab, index) => (
						<button
							class="rounded-md border border-border bg-surface px-4 py-2 text-sm font-medium text-text-muted hover:border-accent/50 hover:text-text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-background"
							type="button"
							aria-pressed={index === 0 ? 'true' : 'false'}
							aria-controls="project-grid"
							data-work-tab={tab.id}
						>
							{tab.label}
						</button>
					))
				}
			</div>

			<div id="project-grid" class="mt-10 grid gap-6 md:grid-cols-2">
				{
					projects.map((project) => (
						<div data-project-card data-project-tabs={project.data.tabs.join(' ')}>
							<ProjectCard project={project} />
						</div>
					))
				}
			</div>

			<p
				class="mt-10 rounded-md border border-border bg-surface px-5 py-8 text-center text-text-muted"
				data-empty-state
				role="status"
				hidden
			>
				No projects in this category yet.
			</p>
		</main>

		<footer class="border-t border-border">
			<div class="mx-auto max-w-content px-page py-6">
				<p class="m-0 text-sm text-text-muted">&copy; 2026 Arako</p>
			</div>
		</footer>

		<script>
			const filterButtons = Array.from(
				document.querySelectorAll<HTMLButtonElement>('[data-work-tab]'),
			);
			const projectCards = Array.from(
				document.querySelectorAll<HTMLElement>('[data-project-card]'),
			);
			const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');

			function filterProjects(tabId: string) {
				let visibleProjects = 0;

				projectCards.forEach((card) => {
					const projectTabs = card.dataset.projectTabs?.split(' ') ?? [];
					const isVisible = tabId === 'all' || projectTabs.includes(tabId);

					card.hidden = !isVisible;
					if (isVisible) visibleProjects += 1;
				});

				filterButtons.forEach((button) => {
					button.setAttribute('aria-pressed', String(button.dataset.workTab === tabId));
				});

				if (emptyState) emptyState.hidden = visibleProjects > 0;
			}

			filterButtons.forEach((button) => {
				button.addEventListener('click', () => {
					const tabId = button.dataset.workTab;
					if (tabId) filterProjects(tabId);
				});
			});
		</script>
	</body>
</html>
