---
import { getCollection } from 'astro:content';

import ButtonLink from '../../components/ButtonLink.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { projectCategories } from '../../config/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';

const filterProjectMinimum = 5;
const sectionProjectMinimum = 4;
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
	(a, b) =>
		(a.data.featuredOrder ?? Number.POSITIVE_INFINITY) -
			(b.data.featuredOrder ?? Number.POSITIVE_INFINITY) ||
		a.data.title.localeCompare(b.data.title),
);
const populatedCategories = projectCategories
	.map((category) => ({
		...category,
		count: projects.filter((project) => project.data.categories.includes(category.id)).length,
	}))
	.filter(({ count }) => count > 0);
const showFilters =
	projects.length >= filterProjectMinimum && populatedCategories.length > 1;
const filters = [
	{ id: 'all', label: 'All projects', count: projects.length },
	...populatedCategories,
];
const featuredProjects = projects.filter(
	(project) => project.data.featuredOrder !== undefined,
);
const remainingProjects = projects.filter(
	(project) => project.data.featuredOrder === undefined,
);
const separateFeaturedProjects =
	projects.length >= sectionProjectMinimum &&
	featuredProjects.length >= 2 &&
	remainingProjects.length >= 2;
const projectSections = separateFeaturedProjects
	? [
			{
				id: 'featured-work',
				eyebrow: 'Selected',
				title: 'Featured work',
				description: 'Combat, movement, abilities, and game systems.',
				projects: featuredProjects,
			},
			{
				id: 'project-archive',
				eyebrow: 'Archive',
				title: 'More projects',
				description: 'Prototypes, smaller systems, and open-source work.',
				projects: remainingProjects,
			},
		]
	: [
			{
				id: 'project-archive',
				eyebrow: 'Portfolio',
				title: 'Projects',
				description: undefined,
				projects,
			},
		];
const projectCountLabel = `${projects.length} ${projects.length === 1 ? 'project' : 'projects'}`;
---

<BaseLayout
	title="Work"
	description="Explore Arako's Roblox development projects, including combat systems, skills, open-source work, and prototypes."
	mainClass="mx-auto w-full max-w-content px-page py-section"
>
	<PageHeader
		eyebrow="Portfolio"
		title="Work"
		description="Roblox combat, movement, abilities, multiplayer systems, and prototypes."
	/>

	{
		projects.length === 0 ? (
			<section
				class="mt-10 max-w-reading rounded-md border border-border-subtle bg-surface px-5 py-8 sm:px-8"
				aria-labelledby="empty-archive-title"
				data-reveal="scale"
			>
				<p class="text-label font-semibold uppercase tracking-label text-accent">Archive status</p>
				<h2 id="empty-archive-title" class="mt-3 text-section-title text-text-primary">
					No public projects yet
				</h2>
				<p class="mt-4 max-w-narrow leading-7 text-text-muted">
					Project write-ups are being prepared and will appear here once they are ready to share.
				</p>
				<ButtonLink class="mt-6" href="/" variant="secondary">
					Return home
				</ButtonLink>
			</section>
		) : (
			<div data-work-archive>
				<div class="mt-10 flex flex-col gap-5 border-y border-border-subtle py-5 sm:flex-row sm:items-end sm:justify-between" data-reveal="left">
					{showFilters && (
						<nav aria-label="Filter projects by category">
							<ul class="flex flex-wrap gap-2">
								{filters.map((filter, index) => (
									<li>
									<a
										class="motion-nav inline-flex min-h-11 items-center gap-2 rounded-md border border-border bg-surface px-4 py-2 text-sm font-medium text-text-muted no-underline hover:border-accent hover:text-text-primary aria-[current=page]:border-accent aria-[current=page]:bg-accent aria-[current=page]:text-background"
											href={filter.id === 'all' ? '/work' : `/work?category=${filter.id}`}
											aria-current={index === 0 ? 'page' : undefined}
											aria-controls="project-sections"
											data-work-filter={filter.id}
											data-filter-label={filter.label}
										>
											{filter.label}
											<span class="font-mono text-xs opacity-75">{filter.count}</span>
										</a>
									</li>
								))}
							</ul>
						</nav>
					)}

					<p
						class="text-sm font-medium text-text-muted"
						role="status"
						aria-live="polite"
						aria-atomic="true"
						data-project-count
					>
						{projectCountLabel}
					</p>
				</div>

				{showFilters && (
					<noscript>
						<p class="mt-4 text-sm leading-6 text-text-muted">
							Category filtering requires JavaScript. Every project remains listed below.
						</p>
					</noscript>
				)}

				<div id="project-sections" class="mt-section-tight grid gap-section-tight">
					{projectSections.map((section, sectionIndex) => (
						<section
							aria-labelledby={`${section.id}-title`}
							data-work-section
						>
							<SectionHeader
								eyebrow={section.eyebrow}
								title={section.title}
								description={section.description}
								titleId={`${section.id}-title`}
							/>

							<ul class="mt-8 grid gap-6 md:grid-cols-2">
								{section.projects.map((project, projectIndex) => (
									<li
										data-project-card
										data-project-categories={project.data.categories.join(' ')}
									>
										<ProjectCard
											{project}
											headingLevel={3}
											priority={sectionIndex === 0 && projectIndex === 0}
											revealDelay={projectIndex % 2}
										/>
									</li>
								))}
							</ul>
						</section>
					))}
				</div>

				<p
					class="mt-10 rounded-md border border-border-subtle bg-surface px-5 py-8 text-center text-text-muted"
					data-filter-empty
					hidden
				>
					No published projects match this category. Choose All projects to restore the archive.
				</p>
			</div>
		)
	}

	{
		showFilters && (
			<script>
				const archive = document.querySelector<HTMLElement>('[data-work-archive]');

				if (archive) {
					const filterLinks = Array.from(
						archive.querySelectorAll<HTMLAnchorElement>('[data-work-filter]'),
					);
					const projectCards = Array.from(
						archive.querySelectorAll<HTMLElement>('[data-project-card]'),
					);
					const projectSections = Array.from(
						archive.querySelectorAll<HTMLElement>('[data-work-section]'),
					);
					const projectCount = archive.querySelector<HTMLElement>('[data-project-count]');
					const emptyState = archive.querySelector<HTMLElement>('[data-filter-empty]');

					function selectedCategory() {
						const category = new URL(window.location.href).searchParams.get('category');

						return filterLinks.some((link) => link.dataset.workFilter === category)
							? category ?? 'all'
							: 'all';
					}

					function filterProjects(category: string) {
						let visibleProjects = 0;

						projectCards.forEach((card) => {
							const categories = card.dataset.projectCategories?.split(' ') ?? [];
							const isVisible =
								category === 'all' || categories.includes(category);

							card.hidden = !isVisible;
							if (isVisible) visibleProjects += 1;
						});

						projectSections.forEach((section) => {
							const sectionCards = Array.from(
								section.querySelectorAll<HTMLElement>('[data-project-card]'),
							);
							section.hidden = sectionCards.every((card) => card.hidden);
						});

						filterLinks.forEach((link) => {
							if (link.dataset.workFilter === category) {
								link.setAttribute('aria-current', 'page');
							} else {
								link.removeAttribute('aria-current');
							}
						});

						const activeFilter = filterLinks.find(
							(link) => link.dataset.workFilter === category,
						);
						const noun = visibleProjects === 1 ? 'project' : 'projects';
						const categoryLabel = activeFilter?.dataset.filterLabel;

						if (projectCount) {
							projectCount.textContent =
								category === 'all'
									? `${visibleProjects} ${noun}`
									: `${visibleProjects} ${noun} in ${categoryLabel}`;
						}

						if (emptyState) emptyState.hidden = visibleProjects > 0;
					}

					filterLinks.forEach((link) => {
						link.addEventListener('click', (event) => {
							event.preventDefault();

							const category = link.dataset.workFilter ?? 'all';
							const url = new URL(window.location.href);

							if (category === 'all') {
								url.searchParams.delete('category');
							} else {
								url.searchParams.set('category', category);
							}

							window.history.pushState({}, '', url);
							filterProjects(category);
						});
					});

					window.addEventListener('popstate', () => filterProjects(selectedCategory()));
					filterProjects(selectedCategory());
				}
			</script>
		)
	}
</BaseLayout>
