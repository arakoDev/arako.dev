---
import { getCollection } from 'astro:content';

import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { workTabs } from '../../config/workTabs';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort(
	(a, b) =>
		Number(b.data.featured) - Number(a.data.featured) ||
		b.data.year - a.data.year ||
		a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
	title="Work"
	description="Explore Arako's Roblox development projects, including combat systems, skills, open-source work, and prototypes."
	mainClass="mx-auto w-full max-w-content px-page py-section"
>
	<PageHeader
		eyebrow="Portfolio"
		title="Work"
		description="A selection of Roblox systems, gameplay features, open-source work, and experiments."
	/>

	<div class="mt-10 flex flex-wrap gap-2" aria-label="Filter projects by category">
		{
			workTabs.map((tab, index) => (
				<button
					class="min-h-11 rounded-md border border-border bg-surface px-4 py-2 text-sm font-medium text-text-muted transition-colors hover:border-accent hover:text-text-primary aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-background"
					type="button"
					aria-pressed={index === 0 ? 'true' : 'false'}
					aria-controls="project-grid"
					data-work-tab={tab.id}
				>
					{tab.label}
				</button>
			))
		}
	</div>

	<div id="project-grid" class="mt-10 grid gap-6 md:grid-cols-2">
		{
			projects.map((project) => (
				<div data-project-card data-project-tabs={project.data.tabs.join(' ')}>
					<ProjectCard project={project} />
				</div>
			))
		}
	</div>

	<p
		class="mt-10 rounded-md border border-border-subtle bg-surface px-5 py-8 text-center text-text-muted"
		data-empty-state
		role="status"
		hidden
	>
		No projects in this category yet.
	</p>
	<script>
		const filterButtons = Array.from(
			document.querySelectorAll<HTMLButtonElement>('[data-work-tab]'),
		);
		const projectCards = Array.from(
			document.querySelectorAll<HTMLElement>('[data-project-card]'),
		);
		const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');

		function filterProjects(tabId: string) {
			let visibleProjects = 0;

			projectCards.forEach((card) => {
				const projectTabs = card.dataset.projectTabs?.split(' ') ?? [];
				const isVisible = tabId === 'all' || projectTabs.includes(tabId);

				card.hidden = !isVisible;
				if (isVisible) visibleProjects += 1;
			});

			filterButtons.forEach((button) => {
				button.setAttribute('aria-pressed', String(button.dataset.workTab === tabId));
			});

			if (emptyState) emptyState.hidden = visibleProjects > 0;
		}

		filterButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const tabId = button.dataset.workTab;
				if (tabId) filterProjects(tabId);
			});
		});
	</script>
</BaseLayout>
