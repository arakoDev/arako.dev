---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import ButtonLink from '../../components/ButtonLink.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCredits from '../../components/ProjectCredits.astro';
import ProjectMeta from '../../components/ProjectMeta.astro';
import ProjectNavigation from '../../components/ProjectNavigation.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import {
	projectCategoryLabels,
	projectLinkLabels,
	projectStatusLabels,
} from '../../config/projects';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
	project: CollectionEntry<'projects'>;
	nextProject?: {
		id: string;
		title: string;
	};
}

export async function getStaticPaths() {
	const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
		(a, b) =>
			(a.data.featuredOrder ?? Number.POSITIVE_INFINITY) -
				(b.data.featuredOrder ?? Number.POSITIVE_INFINITY) ||
			b.data.year - a.data.year ||
			a.data.title.localeCompare(b.data.title),
	);

	return projects.map((project, index) => {
		const nextProject =
			projects.length > 1 ? projects[(index + 1) % projects.length] : undefined;

		return {
			params: { slug: project.id },
			props: {
				project,
				nextProject: nextProject
					? { id: nextProject.id, title: nextProject.data.title }
					: undefined,
			},
		};
	});
}

const { project, nextProject } = Astro.props;
const { Content } = await render(project);
const {
	category,
	client,
	confidentiality,
	credits,
	duration,
	heroAlt,
	heroCaption,
	heroImage,
	heroVideo,
	links,
	outcome,
	role,
	services,
	status,
	summary,
	tags,
	team,
	title,
	year,
} = project.data;
const projectLinks = links.map((link) => ({
	...link,
	label: link.label ?? projectLinkLabels[link.type],
}));
const contactNavigation = site.contact.inquiryUrl
	? { href: site.contact.inquiryUrl, title: 'Contact Arako' }
	: undefined;
const relatedServiceNavigation = site.navigation.some(({ href }) => href === '/services')
	? { href: '/services', title: services[0] ?? 'Services' }
	: undefined;
---

<BaseLayout
	{title}
	description={summary}
	mainClass="mx-auto w-full max-w-content px-page py-section"
>
	<article>
		<div class="max-w-4xl">
			<ButtonLink href="/work" variant="text">&larr; Back to work</ButtonLink>

			<PageHeader
				class="mt-8"
				eyebrow={`${projectCategoryLabels[category]} · ${year}`}
				{title}
				description={summary}
			/>
		</div>

		<ProjectMeta
			class="mt-10"
			{year}
			{role}
			{duration}
			status={projectStatusLabels[status]}
			{team}
			{client}
			{services}
			{tags}
		/>

		<MediaFrame
			class="mt-10"
			image={heroImage}
			alt={heroAlt}
			{title}
			caption={heroCaption}
			videoUrl={heroVideo}
		/>

		<div class="prose-portfolio mt-12 max-w-reading border-t border-border-subtle pt-10">
			<Content />
		</div>

		{
			outcome && (
				<section
					class="mt-12 max-w-reading border-t border-border-subtle pt-10"
					aria-labelledby="project-outcome-title"
				>
					<SectionHeader title="Outcome" titleId="project-outcome-title" />
					<p class="mt-5 leading-7 text-text-muted">{outcome}</p>
				</section>
			)
		}

		{
			confidentiality && (
				<aside class="mt-10 max-w-reading border-l-2 border-brass bg-surface px-5 py-4">
					<p class="text-label font-semibold uppercase tracking-label text-text-primary">
						Confidentiality note
					</p>
					<p class="mt-2 text-sm leading-6 text-text-muted">{confidentiality}</p>
				</aside>
			)
		}

		{credits.length > 0 && <ProjectCredits class="mt-12 max-w-reading" {credits} />}

		{
			projectLinks.length > 0 && (
				<section
					class="mt-12 max-w-reading border-t border-border-subtle pt-10"
					aria-labelledby="project-links-title"
				>
					<SectionHeader title="Project links" titleId="project-links-title" />
					<div class="mt-5 flex flex-wrap gap-3">
						{projectLinks.map((link) => (
							<ButtonLink
								class="gap-2"
								href={link.url}
								target="_blank"
								variant="secondary"
								aria-label={`${link.label} for ${title} (opens in a new tab)`}
							>
								{link.label}
								<span aria-hidden="true">↗</span>
							</ButtonLink>
						))}
					</div>
				</section>
			)
		}

		<ProjectNavigation
			class="mt-section-tight"
			relatedService={relatedServiceNavigation}
			nextProject={nextProject
				? { href: `/work/${nextProject.id}`, title: nextProject.title }
				: undefined}
			contact={contactNavigation}
		/>
	</article>
</BaseLayout>
