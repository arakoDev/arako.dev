---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import Header from '../../components/Header.astro';
import '../../styles/global.css';

interface Props {
	project: CollectionEntry<'projects'>;
}

interface ProjectLink {
	label: string;
	url: string;
}

export async function getStaticPaths() {
	const projects = await getCollection('projects');

	return projects.map((project) => ({
		params: { slug: project.data.slug },
		props: { project },
	}));
}

function getYouTubeEmbedUrl(videoUrl?: string) {
	if (!videoUrl) return undefined;

	const url = new URL(videoUrl);
	const hostname = url.hostname.replace(/^www\./, '');
	let videoId: string | null | undefined;

	if (hostname === 'youtu.be') {
		videoId = url.pathname.split('/').filter(Boolean)[0];
	} else if (hostname.endsWith('youtube.com') || hostname.endsWith('youtube-nocookie.com')) {
		videoId = url.searchParams.get('v');

		if (!videoId) {
			const [route, id] = url.pathname.split('/').filter(Boolean);

			if (['embed', 'live', 'shorts'].includes(route)) {
				videoId = id;
			}
		}
	}

	return videoId
		? `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}`
		: undefined;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { description, externalUrl, gameUrl, sourceUrl, thumbnail, title, video, year } =
	project.data;
const videoEmbedUrl = getYouTubeEmbedUrl(video);
const projectLinks = [
	gameUrl ? { label: 'Game', url: gameUrl } : null,
	sourceUrl ? { label: 'GitHub', url: sourceUrl } : null,
	externalUrl ? { label: 'External Link', url: externalUrl } : null,
].filter((link): link is ProjectLink => link !== null);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<title>{title} | Arako</title>
	</head>
	<body class="flex min-h-screen flex-col">
		<Header />

		<main class="mx-auto w-full max-w-content flex-1 px-page py-section">
			<article class="max-w-4xl">
				<a class="text-sm font-medium text-text-muted no-underline hover:text-accent" href="/#work">
					&larr; Back to work
				</a>

				<header class="mt-8 max-w-3xl">
					<p class="m-0 text-sm font-semibold uppercase tracking-[0.14em] text-accent">{year}</p>
					<h1 class="mt-3 text-4xl font-semibold tracking-[-0.03em] text-text-primary sm:text-6xl">
						{title}
					</h1>
					<p class="mt-5 text-base leading-7 text-text-muted sm:text-lg sm:leading-8">
						{description}
					</p>
				</header>

				{
					videoEmbedUrl ? (
						<div class="mt-10 aspect-video overflow-hidden rounded-md border border-border bg-surface">
							<iframe
								class="h-full w-full"
								src={videoEmbedUrl}
								title={`${title} video`}
								loading="lazy"
								referrerpolicy="strict-origin-when-cross-origin"
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
								allowfullscreen
							/>
						</div>
					) : (
						<img
							class="mt-10 aspect-video w-full rounded-md border border-border object-cover"
							src={thumbnail}
							alt={`${title} thumbnail`}
						/>
					)
				}

				<div
					class="mt-12 max-w-3xl border-t border-border pt-10 text-text-muted [&_a]:text-accent [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-text-primary [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-text-primary [&_li]:mt-2 [&_ol]:mt-5 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mt-5 [&_p]:leading-7 [&_strong]:text-text-primary [&_ul]:mt-5 [&_ul]:list-disc [&_ul]:pl-6"
				>
					<Content />
				</div>

				{
					projectLinks.length > 0 && (
						<section class="mt-12 border-t border-border pt-10" aria-labelledby="project-links-title">
							<h2 id="project-links-title" class="text-xl font-semibold text-text-primary">
								Project links
							</h2>
							<div class="mt-5 flex flex-wrap gap-3">
								{projectLinks.map((link) => (
									<a
										class="inline-flex items-center justify-center rounded-md border border-border bg-surface px-4 py-2.5 text-sm font-semibold text-text-primary no-underline hover:border-accent/50 hover:text-accent"
										href={link.url}
										target="_blank"
										rel="noreferrer"
									>
										{link.label}
									</a>
								))}
							</div>
						</section>
					)
				}
			</article>
		</main>

		<footer class="border-t border-border">
			<div class="mx-auto max-w-content px-page py-6">
				<p class="m-0 text-sm text-text-muted">&copy; 2026 Arako</p>
			</div>
		</footer>
	</body>
</html>
