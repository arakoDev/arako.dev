---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';

import ButtonLink from '../../components/ButtonLink.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { projectLinkLabels } from '../../config/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
	project: CollectionEntry<'projects'>;
}

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

function getYouTubeEmbedUrl(videoUrl?: string) {
	if (!videoUrl) return undefined;

	const url = new URL(videoUrl);
	const hostname = url.hostname.replace(/^www\./, '');
	let videoId: string | null | undefined;

	if (hostname === 'youtu.be') {
		videoId = url.pathname.split('/').filter(Boolean)[0];
	} else if (hostname.endsWith('youtube.com') || hostname.endsWith('youtube-nocookie.com')) {
		videoId = url.searchParams.get('v');

		if (!videoId) {
			const [route, id] = url.pathname.split('/').filter(Boolean);

			if (['embed', 'live', 'shorts'].includes(route)) {
				videoId = id;
			}
		}
	}

	return videoId
		? `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}`
		: undefined;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { heroAlt, heroImage, heroVideo, links, summary, title, year } = project.data;
const videoEmbedUrl = getYouTubeEmbedUrl(heroVideo);
const projectLinks = links.map((link) => ({
	...link,
	label: link.label ?? projectLinkLabels[link.type],
}));
---

<BaseLayout
	{title}
	description={summary}
	mainClass="mx-auto w-full max-w-content px-page py-section"
>
	<article class="max-w-4xl">
		<ButtonLink href="/work" variant="text">&larr; Back to work</ButtonLink>

		<PageHeader class="mt-8" eyebrow={year} {title} description={summary} />

		{
			videoEmbedUrl ? (
				<div class="mt-10 aspect-video overflow-hidden rounded-md border border-border-subtle bg-surface">
					<iframe
						class="h-full w-full"
						src={videoEmbedUrl}
						title={`${title} video`}
						loading="lazy"
						referrerpolicy="strict-origin-when-cross-origin"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
					/>
				</div>
			) : (
				<Image
					class="mt-10 aspect-video w-full rounded-md border border-border-subtle object-cover"
					src={heroImage}
					alt={heroAlt}
				/>
			)
		}

		<div class="prose-portfolio mt-12 max-w-reading border-t border-border-subtle pt-10">
			<Content />
		</div>

		{
			projectLinks.length > 0 && (
				<section class="mt-12 border-t border-border-subtle pt-10" aria-labelledby="project-links-title">
					<SectionHeader title="Project links" titleId="project-links-title" />
					<div class="mt-5 flex flex-wrap gap-3">
						{projectLinks.map((link) => (
							<ButtonLink href={link.url} target="_blank" variant="secondary">
								{link.label}
							</ButtonLink>
						))}
					</div>
				</section>
			)
		}
	</article>
</BaseLayout>
