---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import ButtonLink from '../../components/ButtonLink.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCredits from '../../components/ProjectCredits.astro';
import ProjectNavigation from '../../components/ProjectNavigation.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { projectCategoryLabels, projectLinkLabels } from '../../config/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
	project: CollectionEntry<'projects'>;
	nextProject?: {
		id: string;
		title: string;
	};
}

export async function getStaticPaths() {
	const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
		(a, b) =>
			(a.data.featuredOrder ?? Number.POSITIVE_INFINITY) -
				(b.data.featuredOrder ?? Number.POSITIVE_INFINITY) ||
			a.data.title.localeCompare(b.data.title),
	);

	return projects.map((project, index) => {
		const nextProject =
			projects.length > 1 ? projects[(index + 1) % projects.length] : undefined;

		return {
			params: { slug: project.id },
			props: {
				project,
				nextProject: nextProject
					? { id: nextProject.id, title: nextProject.data.title }
					: undefined,
			},
		};
	});
}

const { project, nextProject } = Astro.props;
const { Content } = await render(project);
const hasBodyContent = Boolean(project.body?.trim());
const {
	categories,
	confidentiality,
	credits,
	heroAlt,
	heroCaption,
	heroImage,
	heroVideo,
	links,
	outcome,
	summary,
	title,
} = project.data;
const projectLinks = links.map((link) => ({
	...link,
	label: link.label ?? projectLinkLabels[link.type],
}));
const categoryLabel = categories.map((category) => projectCategoryLabels[category]).join(' · ');
---

<BaseLayout
	{title}
	description={summary}
	mainClass="mx-auto w-full max-w-content px-page py-section"
>
	<article>
		<div class="max-w-4xl">
			<div data-reveal="left">
				<ButtonLink href="/work" variant="text">&larr; Back to work</ButtonLink>
			</div>

			<PageHeader
				class="mt-8"
				eyebrow={categoryLabel}
				{title}
				description={summary}
				revealDelay={1}
			/>
		</div>

		<MediaFrame
			class="mt-10"
			image={heroImage}
			alt={heroAlt}
			{title}
			caption={heroCaption}
			videoUrl={heroVideo}
		/>

		{
			hasBodyContent && (
				<div class="mt-12 border-t border-border-subtle pt-10">
					<div class="prose-portfolio max-w-reading" data-reveal-children>
						<Content />
					</div>
				</div>
			)
		}

		{
			outcome && (
				<section
					class="mt-12 max-w-reading border-t border-border-subtle pt-10"
					aria-labelledby="project-outcome-title"
				>
					<SectionHeader title="Outcome" titleId="project-outcome-title" />
					<p class="mt-5 leading-7 text-text-muted" data-reveal data-reveal-delay="1">{outcome}</p>
				</section>
			)
		}

		{
			confidentiality && (
				<aside class="mt-10 max-w-reading border-l-2 border-brass bg-surface px-5 py-4" data-reveal="scale">
					<p class="text-label font-semibold uppercase tracking-label text-text-primary">
						Confidentiality note
					</p>
					<p class="mt-2 text-sm leading-6 text-text-muted">{confidentiality}</p>
				</aside>
			)
		}

		{credits.length > 0 && <ProjectCredits class="mt-12 max-w-reading" {credits} />}

		{
			projectLinks.length > 0 && (
				<section
					class="mt-12 border-t border-border-subtle pt-10"
					aria-labelledby="project-links-title"
				>
					<div class="max-w-reading">
						<SectionHeader title="Project links" titleId="project-links-title" />
						<div class="mt-5 flex flex-wrap gap-3" data-reveal data-reveal-delay="1">
							{projectLinks.map((link) => (
								<ButtonLink
									class="gap-2"
									href={link.url}
									target="_blank"
									variant="secondary"
									aria-label={`${link.label} for ${title} (opens in a new tab)`}
								>
									{link.label}
									<span aria-hidden="true">↗</span>
								</ButtonLink>
							))}
						</div>
					</div>
				</section>
			)
		}

		<ProjectNavigation
			class="mt-section-tight"
			nextProject={nextProject
				? { href: `/work/${nextProject.id}`, title: nextProject.title }
				: undefined}
		/>
	</article>
</BaseLayout>
