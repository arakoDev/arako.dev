---
import CommissionNavigation from '../components/CommissionNavigation.astro';
import PageHeader from '../components/PageHeader.astro';
import { commissionMinimum, priceRanges } from '../config/commissions';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Pricing"
	description="Estimated pricing for Roblox development commissions by Arako."
	mainClass="mx-auto w-full max-w-content px-page py-section"
>
	<PageHeader
		title="Pricing"
		description="Estimate ranges for planning a budget. Every commission receives a final quote based on its actual scope."
	/>

	<div class="mt-10">
		<CommissionNavigation />
	</div>

	<div class="mt-section-tight grid border-y border-border-subtle sm:grid-cols-[minmax(12rem,0.65fr)_minmax(0,1.35fr)]" data-reveal="scale">
		<div class="py-8 sm:pr-8">
			<p class="text-label font-semibold uppercase tracking-label text-accent">Minimum commission</p>
			<p class="mt-3 text-5xl font-semibold tracking-tight text-text-primary">{commissionMinimum}</p>
		</div>
		<p class="border-t border-border-subtle py-8 text-base leading-7 text-text-muted sm:border-l sm:border-t-0 sm:pl-8">
			Prices vary with scope, complexity, the existing codebase, polish, integrations, and deadline.
			The ranges below are estimates, not fixed packages. Larger or custom commissions receive a custom quote.
		</p>
	</div>

	<section class="mt-section-tight" aria-labelledby="ranges-heading">
		<h2 id="ranges-heading" class="sr-only">Estimate ranges</h2>
		<div class="divide-y divide-border-subtle border-y border-border-subtle" data-reveal-children>
			{
				priceRanges.map((price, index) => (
					<article class="grid gap-5 py-8 sm:grid-cols-[3rem_minmax(10rem,0.55fr)_minmax(0,1.45fr)] sm:gap-7">
						<p class="font-mono text-sm text-accent">0{index + 1}</p>
						<div>
							<h3 class="text-lg font-semibold text-text-primary">{price.label}</h3>
							<p class="mt-2 text-2xl font-semibold tracking-tight text-text-primary">{price.range}</p>
						</div>
						<p class="max-w-3xl text-base leading-7 text-text-muted">{price.description}</p>
					</article>
				))
			}
		</div>
	</section>

	<nav class="mt-section-tight flex flex-wrap gap-x-6 gap-y-3 border-t border-border-subtle pt-6 text-sm" aria-label="Related commission information" data-reveal="left">
		<a class="motion-text-link font-semibold" href="/commissions">← Commission Info</a>
		<a class="motion-text-link font-semibold" href="/payments">Payment methods and fees →</a>
	</nav>
</BaseLayout>
